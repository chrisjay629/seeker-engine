# ─────────────────────────────────────────────────────────────
# SEEKER — Environment Variables (TEMPLATE)
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# ── Recon Pass — Multi-model gateway ──
# OpenRouter: single API key for all major LLMs (Recon Pass sweep).
# Replaced "Blue Minds" (bluesminds.com) — rejected as a grey-market reseller.
# See build log 2026-07-01 for the full decision.
# Call models by id, e.g. anthropic/claude-opus-4.6, openai/gpt-5.4,
# google/gemini-..., x-ai/grok-..., deepseek/...
OPENROUTER_API_KEY=

# ── Speed inference (direct, separate from Blue Minds) ──
# Groq: LPU inference for open-source model calls
GROQ_API_KEY=

# ── The Mind — expensive layer, rationed ──
# Anthropic: Claude with Extended Thinking (question generation, impact maps)
ANTHROPIC_API_KEY=

# ── Search & Fetch layer ──
# Exa AI: semantic search (incl. YouTube-filtered URL search)
EXA_API_KEY=
# Jina AI: standard page fetcher / fat-trimmer
JINA_API_KEY=
# Firecrawl: JS-rendering / anti-bot fetcher (fallback)
FIRECRAWL_API_KEY=
# Perplexity Pro: web search + multi-model synthesis
PERPLEXITY_API_KEY=

# ── Memory Map — Vector store ──
# Pinecone: cloud vector store (free tier 100K vectors)
PINECONE_API_KEY=
PINECONE_INDEX=seeker-memory-map
PINECONE_ENVIRONMENT=

# ── State Persistence — LangGraph checkpointing ──
# Supabase: hosted Postgres connection string
# Run checkpointer.setup() ONCE only — re-running wipes all tables.
SUPABASE_DB_URL=

# ── Orchestrator ──
# n8n: local for dev (http://localhost:5678), VPS for production
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=

# ── YouTube Transcript layer ──
# youtube-transcript-api requires NO key. Listed for documentation only.
# (no variable needed)

# OpenAlex polite-pool contact (optional). Not a secret — OpenAlex uses it for rate limiting.
OPENALEX_MAILTO=
